{
  "expo": {
    "name": "هنذاكروا",
    "slug": "hanzakro",
    "scheme": "hanzakro",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hanzakro.study",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "يستخدم هنذاكروا خدمة التعرف على الكلام فقط بعد موافقتك.",
        "NSMicrophoneUsageDescription": "يستخدم هنذاكروا الميكروفون للتعرف على كلامك عند بدء التسجيل."
      }
    },
    "android": {
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.hanzakro.study",
      "versionCode": 1,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "welcome",
          "color": "#1479F8"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "يستخدم هنذاكروا الميكروفون للتعرف على كلامك عند بدء التسجيل.",
          "speechRecognitionPermission": "يستخدم هنذاكروا خدمة التعرف على الكلام فقط بعد موافقتك.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-screen-orientation",
      "expo-router"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a9a27a43-c286-489c-828c-fbc68dda272f"
      }
    }
  }
}
